# EditorConfig helps maintain consistent coding styles across editors.
# See https://editorconfig.org for details.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = unset

[*.{ts,html,scss,css}]
indent_style = space
indent_size = 2
final_newline = true

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
